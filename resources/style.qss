
/* =========================================
   ROTK FONT CHANGER
   Compact Launcher Theme
   ========================================= */

/* Main window */
QWidget#rootWindow {
    background-color: #090909;
    color: #f4f4f4;
    border: 1px solid #303030;
}

QWidget#content {
    background-color: #090909;
}

/* =========================================
   TITLE BAR
   ========================================= */

QWidget#titleBar {
    background-color: #070707;
    border-bottom: 1px solid #292929;
}

QLabel#logo {
    color: #ffffff;
    font-size: 19px;
    font-weight: 900;
    border: none;
}

QLabel#separator {
    color: #444444;
    font-size: 19px;
}

QLabel#appName {
    color: #ffffff;
    font-size: 10px;
    font-weight: bold;
}

QPushButton#minimizeButton,
QPushButton#closeButton {
    background: transparent;
    color: #ffffff;
    border: none;
    padding: 0;
    font-size: 19px;
    font-weight: normal;
}

QPushButton#minimizeButton:hover {
    background-color: #292929;
}

QPushButton#closeButton:hover {
    background-color: #df0000;
}

/* =========================================
   HEADINGS
   ========================================= */

QLabel#eyebrow {
    color: #d8d8d8;
    font-size: 10px;
}

QLabel#headline {
    color: #ffffff;
    font-size: 21px;
    font-weight: bold;
}

QLabel#subtitle {
    color: #999999;
    font-size: 11px;
}

/* =========================================
   FONT PREVIEW
   ========================================= */

QWidget#previewPanel {
    background-color: #151515;
    border: 1px solid #2e2e2e;
}

QLabel#previewCaption {
    color: #999999;
    font-size: 10px;
}

QLabel#preview {
    color: #ffffff;
    background: transparent;
    border: none;
    font-size: 28px;
    font-weight: bold;
}

QFrame#panelDivider {
    background-color: #303030;
    color: #303030;
    max-height: 1px;
    border: none;
}

QLabel#fontNameLabel {
    color: #c9c9c9;
    font-size: 11px;
}

QLabel#dropLabel {
    color: #777777;
    font-size: 10px;
}

QLabel#dropLabel[dragActive="true"] {
    color: #f04444;
}

/* =========================================
   BUTTONS
   ========================================= */

QPushButton {
    color: #ffffff;
    background-color: #252525;
    border: none;
    padding: 8px 12px;
    font-size: 11px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #383838;
}

QPushButton:pressed {
    background-color: #171717;
}

/* Browse font */
QPushButton#browseButton {
    font-size: 10px;
    padding: 8px 10px;
}

/* Restore defaults */
QPushButton#resetButton {
    background-color: #242424;
    text-align: left;
}

QPushButton#resetButton:hover {
    background-color: #343434;
}

/* Apply font */
QPushButton#generate {
    background-color: #e00000;
    color: #ffffff;
    font-size: 13px;
    font-weight: bold;
    text-align: left;
}

QPushButton#generate:hover {
    background-color: #f31515;
}

QPushButton#generate:pressed {
    background-color: #ae0000;
}

QPushButton#generate:disabled {
    background-color: #8b1717;
    color: #d9b6b6;
}

/* =========================================
   FOOTER
   ========================================= */

QWidget#footer {
    background-color: #0c0c0c;
    border-top: 1px solid #292929;
}

QLabel#ready {
    font-size: 10px;
    font-weight: bold;
    border: none;
}

QLabel#ready[state="ready"] {
    color: #79a86e;
}

QLabel#ready[state="missing"] {
    color: #e05252;
}

QLabel#pathLabel {
    color: #a5a5a5;
    font-size: 10px;
}

QPushButton#settingsButton {
    background: transparent;
    color: #b8b8b8;
    border: none;
    font-size: 18px;
}

QPushButton#settingsButton:hover {
    color: #ffffff;
    background-color: #242424;
}

/* =========================================
   GAME PATH SETTINGS
   ========================================= */

QWidget#pathPanel {
    background-color: #171717;
    border: 1px solid #303030;
}

QLineEdit#gamePathEdit {
    color: #ffffff;
    background-color: #111111;
    border: 1px solid #393939;
    padding: 7px;
}

QLineEdit#gamePathEdit:focus {
    border-color: #d90000;
}


/* Footer installation path */

QWidget#footer {
    background-color: #0c0c0c;
    border-top: 1px solid #303030;
}

QLineEdit#gamePathEdit {
    background-color: #171717;
    color: #eeeeee;
    border: 1px solid #343434;
    padding: 7px 10px;
    font-size: 11px;
    selection-background-color: #d90000;
}

QLineEdit#gamePathEdit:hover {
    border-color: #555555;
}

QLineEdit#gamePathEdit:focus {
    border-color: #df0000;
}

QPushButton#gameBrowseButton {
    background-color: #252525;
    color: #ffffff;
    border: none;
    padding: 8px 12px;
    font-size: 10px;
    font-weight: bold;
}

QPushButton#gameBrowseButton:hover {
    background-color: #df0000;
}

QLabel#versionLabel {
    color: #777777;
    font-size: 9px;
    font-weight: normal;
    background: transparent;
    border: none;
}

QLabel#unofficialLabel {
    color: #e00000;
    background: transparent;
    border: none;
    font-size: 8px;
    font-weight: bold;
    letter-spacing: 2px;
}

